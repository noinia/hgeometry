--   import:           all-setup, all-quickcheck-setup
--   build-tool-depends: hspec-discover:hspec-discover
--   type:             exitcode-stdio-1.0
--   main-is:          Main.hs
--   hs-source-dirs: test
--   other-modules:
--       Spec
--       Point2Spec
--       PointSpec
--       PointSpec
--       Point.CmpAround
--   build-depends:
--       hgeometry-point:quickcheck
--     , containers                >= 0.6           && < 1

test-suite doctest
    import:           all-setup, all-quickcheck-setup, doctest
    type:             exitcode-stdio-1.0
    main-is:          doctests.hs
    build-tool-depends:  doctest-driver-gen:doctest-driver-gen


--------------------------------------------------------------------------------
-- ** Benchmarks

-- common bench-setup
--   build-depends:
--       tasty-bench           >= 0.3  && < 1
--     , hgeometry
--     , deepseq-generics      >= 0.2  && < 1
--     , hashable              >= 1.4  && < 2
--     , hgeometry:numtypes

-- benchmark benchmarks
--   import: all-setup, hgeometry-setup, bench-setup
--   hs-source-dirs: bench
--   main-is:        Benchmarks.hs
--   type: exitcode-stdio-1.0
--   other-modules:
--     ConvexHull.Bench
--     ConvexHull.GrahamBench
--     ConvexHull.GrahamV2
--     ConvexHull.GrahamInt
--     ConvexHull.GrahamFastest
--     -- ConvexHull.GrahamClassy
--     Util

--------------------------------------------------------------------------------

executable hgeometry-debugger
  import:         all-setup
  hs-source-dirs: server
  main-is:        Main.hs
  ghc-options:    -threaded
  build-depends:
      optparse-applicative >= 0.18      && < 0.19
    , filepath             >= 1.4.100   && < 1.6
    , servant              >= 0.20.3.0  && < 0.21
    , servant-server       >= 0.20.3.0  && < 0.21
    , servant-client       >= 0.20.3.0  && < 0.21
    , aeson                >= 2.2       && < 2.3
    , miso                 >= 1.9       && < 2
    , wai                  >= 3.2       && < 3.3
    , warp                 >= 3.4       && < 3.5
    , mtl                  >= 2.3       && < 2.4
    , async                >= 2.2.6     && < 2.3
    , http-client          >= 0.7.19    && < 0.8
