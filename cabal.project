Write-ghc-environment-files: always
tests: True
benchmarks: True
multi-repl: True
packages:
  hgeometry-combinatorial
  hgeometry-vector
  hgeometry-point
  hgeometry-kernel
  hgeometry-polyLine
  hgeometry-spline
  hgeometry-lineSegmentIntersection
  hgeometry-polygon
  hgeometry-ipe
  hgeometry-svg
  hgeometry-geojson
  hgeometry-debugger
  hgeometry
  hgeometry-examples
  -- ../hiraffe
  -- ../miso-bulma
  -- ../approximate-equality

-- ghc-options: -Werror

allow-newer:
-- 9.12
    servant:QuickCheck,
-- 9.14
    servant:base,
    servant-server:base,
    servant-client:base,
    servant-client:time,
    servant-client-core:base,
    servant-client-core:template-haskell,
    dependent-sum-template:template-haskell,
    palette:base,
    http-media:containers,
    binary:containers,
    dependent-map:containers,
    wavefront:base,
    wavefront:containers,
--     all:base,
--     all:template-haskell,
--     all:containers,
--     all:time,
--     monoidal-containers:aeson,


source-repository-package
    type: git
    location: https://github.com/noinia/hiraffe

source-repository-package
    type: git
    location: https://github.com/noinia/hspec-with-tempfile

source-repository-package
    type: git
    location: https://github.com/noinia/miso-bulma

source-repository-package
    type: git
    location: https://github.com/noinia/wavefront

-- for the approximate  equality that supports typelits
source-repository-package
    type: git
    location: https://github.com/noinia/approximate-equality
    tag: 02fc43ca97dd66940dc3d4ac61ecda7888ec252e

source-repository-package
  type: git
  location: https://github.com/haskell-miso/servant-miso-client
  tag: master

source-repository-package
  type: git
  location: https://github.com/haskell-miso/miso-tagsoup
  tag: master

source-repository-package
  type: git
  location: https://github.com/haskell-miso/miso-aeson
  tag: master

source-repository-package
    type: git
    location: https://github.com/noinia/hs-geojson
